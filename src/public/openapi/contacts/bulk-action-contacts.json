{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCRM API",
    "description": "Complete REST API documentation for FluentCRM \u2014 a self-hosted email marketing and CRM plugin for WordPress.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-crm/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/subscribers/do-bulk-action": {
      "post": {
        "operationId": "bulkActionContacts",
        "summary": "POST Bulk Action Contacts",
        "description": "Perform a bulk action on multiple contacts. Supports adding/removing tags and lists, changing status/type, deleting contacts, sending double opt-in, adding to email sequences/automation funnels/companies, removing from companies, and updating custom fields. When `is_all` is `yes`, processes contacts matching the filter query in chunks. A select-all `delete_contacts` can carry the count the user confirmed (`expected_total`): the first batch is refused with a 409 when more contacts match, and returns `max_contact_id`, which later batches send back so contacts created during the run are not deleted.\n\n<!-- fc:access -->\n\n**Required capability:** `fcrm_manage_contacts`\n\n_Enforced by `SubscriberPolicy::handleBulkActions()`._\n\n<!-- /fc:access -->",
        "tags": [
          "Contacts"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action_name"
                ],
                "properties": {
                  "action_name": {
                    "type": "string",
                    "enum": [
                      "add_to_tags",
                      "remove_from_tags",
                      "add_to_lists",
                      "remove_from_lists",
                      "delete_contacts",
                      "send_double_optin",
                      "change_contact_status",
                      "change_contact_type",
                      "add_to_email_sequence",
                      "add_to_automation",
                      "add_to_company",
                      "remove_from_company",
                      "update_custom_fields"
                    ],
                    "description": "The bulk action to perform."
                  },
                  "subscriber_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Contact IDs to act on (used when `is_all` is not `yes`)."
                  },
                  "is_all": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "If `yes`, applies the action to all contacts matching the `contact_query` filter. Processes in chunks."
                  },
                  "contact_query": {
                    "type": "object",
                    "description": "Filter query to select contacts when `is_all` is `yes`: the same params `GET /subscribers` takes (`filter_type`, `search`, `search_custom_fields`, `tags`, `lists`, `statuses`, `company_ids`, `advanced_filters`), so the action reaches exactly the contacts the list shows.",
                    "properties": {
                      "filter_type": {
                        "type": "string",
                        "enum": [
                          "simple",
                          "advanced"
                        ]
                      },
                      "search": {
                        "type": "string"
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "statuses": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "lists": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "company_ids": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "advanced_filters": {
                        "type": "string",
                        "description": "JSON-encoded advanced filter groups."
                      },
                      "search_custom_fields": {
                        "type": "string",
                        "enum": [
                          "yes"
                        ],
                        "description": "`yes` to also match `search` against custom-field values, so a select-all action covers the same contacts the list showed."
                      }
                    }
                  },
                  "last_id": {
                    "type": "integer",
                    "description": "Last processed contact ID for chunked processing (when `is_all` is `yes`).",
                    "default": 0
                  },
                  "expected_total": {
                    "type": "integer",
                    "description": "`delete_contacts` with `is_all`, first batch only: how many contacts the user confirmed. Refused with a 409 (nothing deleted) when more match now. Omit to skip the check."
                  },
                  "max_contact_id": {
                    "type": "integer",
                    "description": "`delete_contacts` with `is_all`, later batches: the `max_contact_id` the first batch returned. Contacts with a higher id are not deleted."
                  },
                  "action_options": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Tag/list IDs for add/remove tag/list actions."
                  },
                  "new_status": {
                    "type": "string",
                    "description": "New status/type value for `change_contact_status`, `change_contact_type`, sequence/automation/company ID for respective actions."
                  },
                  "custom_field": {
                    "type": "object",
                    "description": "Custom field data for `update_custom_fields` action.",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "Custom field key."
                      },
                      "value": {
                        "description": "Custom field value. A string, number, or array of options for multi-value fields.",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "operation": {
                        "type": "string",
                        "enum": [
                          "add",
                          "subtract"
                        ],
                        "description": "Optional. Only applied when the custom field is a number type (arithmetic add/subtract on the existing value) or a multi-value type (`select-multi`, `checkbox`; add/remove options). Any other value, or a field of another type, replaces the stored value with `value`."
                      }
                    }
                  }
                }
              },
              "example": {
                "action_name": "add_to_tags",
                "subscriber_ids": [
                  1,
                  5,
                  12
                ],
                "action_options": [
                  3,
                  7
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk action completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "completed_contacts": {
                      "type": "integer",
                      "description": "Number of contacts processed in this chunk."
                    },
                    "last_contact_id": {
                      "type": "integer",
                      "description": "Last processed contact ID (for chunked processing)."
                    },
                    "is_completed": {
                      "type": "boolean",
                      "description": "Only present when all contacts have been processed in `is_all` mode."
                    },
                    "max_contact_id": {
                      "type": "integer",
                      "description": "Select-all `delete_contacts` sent with `expected_total` or `max_contact_id`: the highest contact id the run may delete. Send it back as `max_contact_id`."
                    }
                  }
                },
                "example": {
                  "message": "Selected bulk action has been successfully completed",
                  "completed_contacts": 3,
                  "last_contact_id": 12
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Subscribers selection is required"
                }
              }
            }
          },
          "409": {
            "description": "Select-all `delete_contacts`: more contacts match than `expected_total`. Nothing was changed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "matching_total": {
                      "type": "integer",
                      "description": "How many contacts match now."
                    }
                  }
                },
                "example": {
                  "message": "The list changed: 30 contacts match now, but 25 were confirmed. Nothing was changed. Review the list and try again.",
                  "matching_total": 30
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
