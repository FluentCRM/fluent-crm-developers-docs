{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCRM API",
    "description": "Complete REST API documentation for FluentCRM \u2014 a self-hosted email marketing and CRM plugin for WordPress.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-crm/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/dynamic-segments/estimated-contacts": {
      "post": {
        "operationId": "estimateDynamicSegmentContacts",
        "summary": "POST Estimate Dynamic Segment Contacts",
        "description": "Get the estimated number of contacts matching a set of segment filter conditions. Useful for previewing a segment before creating or updating it. Requires FluentCampaign Pro.\n\n<!-- fc:access -->\n\n**Required capability:** `fcrm_manage_contact_cats`\n\n_Enforced by `DynamicSegmentPolicy::verifyRequest()`, the policy default for this route group._\n\n**Requires:** FluentCampaign Pro. Without it the route does not exist.\n\n<!-- /fc:access -->",
        "tags": [
          "Dynamic Segments"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "filters"
                ],
                "properties": {
                  "filters": {
                    "type": "array",
                    "description": "Advanced-filter groups. Rules within one group are combined with AND; separate groups are combined with OR.",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "example": [
                        {
                          "source": [
                            "segment",
                            "status"
                          ],
                          "operator": "in",
                          "value": [
                            "subscribed"
                          ]
                        },
                        {
                          "source": [
                            "activities",
                            "email_opened"
                          ],
                          "operator": "days_within",
                          "value": 14
                        }
                      ],
                      "items": {
                        "type": "object",
                        "required": [
                          "source",
                          "operator",
                          "value"
                        ],
                        "properties": {
                          "source": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "string"
                            }
                          },
                          "operator": {
                            "type": "string"
                          },
                          "value": {
                            "description": "Value to compare against; its type depends on the source and operator."
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "filters": [
                  [
                    {
                      "source": [
                        "segment",
                        "status"
                      ],
                      "operator": "in",
                      "value": [
                        "subscribed"
                      ]
                    },
                    {
                      "source": [
                        "activities",
                        "email_opened"
                      ],
                      "operator": "days_within",
                      "value": 14
                    }
                  ]
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estimated contact count.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "description": "Number of contacts matching the provided filters.",
                      "example": 245
                    }
                  }
                },
                "example": {
                  "count": 245
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
