{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCRM API",
    "description": "Complete REST API documentation for FluentCRM \u2014 a self-hosted email marketing and CRM plugin for WordPress.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-crm/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/dynamic-segments/{id}": {
      "put": {
        "operationId": "updateDynamicSegment",
        "summary": "PUT Update Dynamic Segment",
        "description": "Update an existing custom dynamic segment's title and grouped filters. The `segment` parameter is a JSON-encoded string. Rules within one group are combined with AND; separate groups are combined with OR. Requires FluentCampaign Pro.\n\n<!-- fc:access -->\n\n**Required capability:** `fcrm_manage_contact_cats`\n\n_Enforced by `DynamicSegmentPolicy::verifyRequest()`, the policy default for this route group._\n\n**Requires:** FluentCampaign Pro. Without it the route does not exist.\n\n<!-- /fc:access -->",
        "tags": [
          "Dynamic Segments"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the custom segment to update.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "segment"
                ],
                "properties": {
                  "segment": {
                    "type": "string",
                    "description": "JSON-encoded segment object containing the updated title and at least one grouped filter rule. Rules within one group use AND; separate groups use OR.",
                    "example": "{\"title\":\"Recently engaged subscribers\",\"filters\":[[{\"source\":[\"segment\",\"status\"],\"operator\":\"in\",\"value\":[\"subscribed\"]},{\"source\":[\"activities\",\"email_opened\"],\"operator\":\"days_within\",\"value\":14}]]}"
                  }
                }
              },
              "example": {
                "segment": "{\"title\":\"Recently engaged subscribers\",\"filters\":[[{\"source\":[\"segment\",\"status\"],\"operator\":\"in\",\"value\":[\"subscribed\"]},{\"source\":[\"activities\",\"email_opened\"],\"operator\":\"days_within\",\"value\":14}]]}"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Segment updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Success message."
                    },
                    "segment": {
                      "type": "object",
                      "description": "The updated segment data object with the assigned ID.",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "Segment ID."
                        },
                        "title": {
                          "type": "string",
                          "description": "Updated segment title."
                        },
                        "filters": {
                          "type": "array",
                          "description": "Updated advanced-filter groups. Rules within a group use AND; groups use OR.",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "Segment has been updated",
                  "segment": {
                    "id": 12,
                    "title": "Recently engaged subscribers",
                    "filters": [
                      [
                        {
                          "source": [
                            "segment",
                            "status"
                          ],
                          "operator": "in",
                          "value": [
                            "subscribed"
                          ]
                        },
                        {
                          "source": [
                            "activities",
                            "email_opened"
                          ],
                          "operator": "days_within",
                          "value": 14
                        }
                      ]
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Please provide segment title"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
