{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCRM API",
    "description": "Complete REST API documentation for FluentCRM \u2014 a self-hosted email marketing and CRM plugin for WordPress.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-crm/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/dynamic-segments": {
      "post": {
        "operationId": "createDynamicSegment",
        "summary": "POST Create Dynamic Segment",
        "description": "Create a new custom dynamic segment with grouped filters. The `segment` parameter is a JSON-encoded string containing `title` and `filters`. Rules within one group are combined with AND; separate groups are combined with OR. Requires FluentCampaign Pro.\n\n<!-- fc:access -->\n\n**Required capability:** `fcrm_manage_contact_cats`\n\n_Enforced by `DynamicSegmentPolicy::verifyRequest()`, the policy default for this route group._\n\n**Requires:** FluentCampaign Pro. Without it the route does not exist.\n\n<!-- /fc:access -->",
        "tags": [
          "Dynamic Segments"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "segment"
                ],
                "properties": {
                  "segment": {
                    "type": "string",
                    "description": "JSON-encoded segment object containing a title and at least one grouped filter rule. Rules within one group use AND; separate groups use OR.",
                    "example": "{\"title\":\"Contacts with either tag\",\"filters\":[[{\"source\":[\"segment\",\"tags\"],\"operator\":\"in\",\"value\":[12,18]}]]}"
                  }
                }
              },
              "example": {
                "segment": "{\"title\":\"Contacts with either tag\",\"filters\":[[{\"source\":[\"segment\",\"tags\"],\"operator\":\"in\",\"value\":[12,18]}]]}"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Segment created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Success message."
                    },
                    "segment": {
                      "$ref": "#/components/schemas/CustomSegmentData"
                    }
                  }
                },
                "example": {
                  "message": "Segment has been created",
                  "segment": {
                    "id": 12,
                    "slug": "custom_segment",
                    "title": "Contacts with either tag",
                    "filters": [
                      [
                        {
                          "source": [
                            "segment",
                            "tags"
                          ],
                          "operator": "in",
                          "value": [
                            12,
                            18
                          ]
                        }
                      ]
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Add at least one condition. A segment without conditions would include every contact."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            }
          }
        }
      },
      "CustomSegmentData": {
        "type": "object",
        "description": "Custom segment data object.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier (Meta table ID)."
          },
          "slug": {
            "type": "string",
            "description": "Segment type slug (always `custom_segment` for custom segments)."
          },
          "title": {
            "type": "string",
            "description": "Display name of the segment."
          },
          "filters": {
            "type": "array",
            "description": "Filter groups. Rules within a group use AND; groups use OR.",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/components/schemas/SegmentFilterRule"
              }
            }
          }
        }
      },
      "SegmentFilterRule": {
        "type": "object",
        "description": "A single advanced contact filter rule.",
        "required": [
          "source",
          "operator",
          "value"
        ],
        "properties": {
          "source": {
            "type": "array",
            "description": "Two-part filter source: provider followed by property, for example `[\"segment\", \"tags\"]` or `[\"activities\", \"email_opened\"]`.",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "operator": {
            "type": "string",
            "description": "Advanced-filter operator supported by the selected source, such as `in`, `contains`, or `days_within`."
          },
          "value": {
            "description": "Value to compare against. Its type depends on the selected source and operator.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              {
                "type": "integer"
              }
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
