{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCRM API",
    "description": "Complete REST API documentation for FluentCRM \u2014 a self-hosted email marketing and CRM plugin for WordPress.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-crm/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/messaging/messages": {
      "get": {
        "operationId": "listMessagingMessages",
        "summary": "GET List Messaging Messages",
        "description": "The Activities list: every message, inbound and outbound, newest activity first. `channel` is a **filter** here: `sms` or `whatsapp` narrows the list (and the status counts); omit it, or send anything else, to include all channels. The result key is still named `sms` for backward compatibility even though rows can be WhatsApp. `status` and `sms_type` accept comma-separated lists; unknown values are dropped. The `statuses` array carries a count per status for the filter dropdown, limited to `pending`, `sent`, `delivered`, `failed`, `cancelled` and `received` (messages in other states such as `read` or `scheduled` are not counted or filterable here). **PRO** \u2014 requires the FluentCampaign Pro Messaging module with at least one channel (SMS or WhatsApp) active.\n\n<!-- fc:access -->\n\n**Required capability:** `fcrm_read_emails` or `fcrm_manage_emails` \u2014 which one applies depends on the action being performed.\n\n_Enforced by `MessagePolicy::verifyRequest()`, the policy default for this route group._\n\n**Requires:** FluentCampaign Pro **with the Messaging module enabled**. While no messaging channel (SMS or WhatsApp) is switched on the route is not registered at all and returns a 404.\n\n<!-- /fc:access -->",
        "tags": [
          "Messaging"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "description": "Filter by channel.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "sms",
                "whatsapp"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Comma-separated statuses: `pending`, `sent`, `delivered`, `failed`, `cancelled`, `received`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sms_type",
            "in": "query",
            "description": "Comma-separated types: `campaign`, `automation`, `custom_sms`, `broadcast`, `incoming`. `custom_sms` and `broadcast` both mean outbound with no campaign or automation behind it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Match message content, the conversation's phone number or the contact's name/email.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Rows per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sms": {
                      "type": "object",
                      "description": "Paginated result set.",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "Total number of matching rows."
                        },
                        "per_page": {
                          "type": "integer",
                          "description": "Rows per page."
                        },
                        "current_page": {
                          "type": "integer",
                          "description": "Current page number."
                        },
                        "last_page": {
                          "type": "integer",
                          "description": "Number of the final page."
                        },
                        "from": {
                          "type": "integer",
                          "description": "Index of the first row on this page."
                        },
                        "to": {
                          "type": "integer",
                          "description": "Index of the last row on this page."
                        },
                        "next_page_url": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "URL of the next page, or null."
                        },
                        "prev_page_url": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "URL of the previous page, or null."
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MessageActivity"
                          }
                        }
                      }
                    },
                    "statuses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "description": "Status."
                          },
                          "label": {
                            "type": "string",
                            "description": "Display label."
                          },
                          "count": {
                            "type": "integer",
                            "description": "Messages in that status."
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "sms": {
                    "current_page": 1,
                    "per_page": 10,
                    "total": 1,
                    "last_page": 1,
                    "from": 1,
                    "to": 1,
                    "next_page_url": null,
                    "prev_page_url": null,
                    "data": [
                      {
                        "id": 9001,
                        "message_content": "Hi Sam, 20% off this weekend",
                        "mobile_number": "+447700900123",
                        "channel": "whatsapp",
                        "sms_type": "campaign",
                        "status": "delivered",
                        "direction": "outbound",
                        "sent_at": "2026-10-03 09:00:12",
                        "scheduled_at": "2026-10-03 09:00:00",
                        "created_at": "2026-10-03 08:55:01",
                        "subscriber_id": 41,
                        "subscriber": {
                          "id": 41,
                          "email": "sam@example.com"
                        },
                        "campaign": {
                          "title": "Weekend flash sale"
                        }
                      }
                    ]
                  },
                  "statuses": [
                    {
                      "value": "delivered",
                      "label": "Delivered",
                      "count": 120
                    },
                    {
                      "value": "sent",
                      "label": "Sent",
                      "count": 310
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated \u2014 missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated but the user lacks the capability this route requires.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            }
          }
        }
      },
      "MessageActivity": {
        "type": "object",
        "description": "One row of the Activities list, shaped for the activity table.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "message_content": {
            "type": [
              "string",
              "null"
            ]
          },
          "mobile_number": {
            "type": "string",
            "description": "The conversation's phone number."
          },
          "channel": {
            "type": "string",
            "enum": [
              "sms",
              "whatsapp"
            ]
          },
          "sms_type": {
            "type": "string",
            "description": "Legacy type label derived from direction and ref_type.",
            "enum": [
              "campaign",
              "automation",
              "custom_sms",
              "incoming"
            ]
          },
          "status": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date-time in the site timezone, `Y-m-d H:i:s`."
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date-time in the site timezone, `Y-m-d H:i:s`."
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date-time in the site timezone, `Y-m-d H:i:s`."
          },
          "subscriber_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "subscriber": {
            "type": [
              "object",
              "null"
            ],
            "description": "The linked CRM contact, or null for a number with no contact."
          },
          "campaign": {
            "type": [
              "object",
              "null"
            ],
            "description": "Campaign (or automation) the message belongs to.",
            "properties": {
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
