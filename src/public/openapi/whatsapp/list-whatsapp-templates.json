{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCRM API",
    "description": "Complete REST API documentation for FluentCRM \u2014 a self-hosted email marketing and CRM plugin for WordPress.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-crm/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/whatsapp/templates": {
      "get": {
        "operationId": "listWhatsAppTemplates",
        "summary": "GET WhatsApp Templates",
        "description": "List the template catalogue stored in `fc_message_templates` (newest first) together with review-status counts. Despite the `whatsapp/` prefix the catalogue is shared by channels: `channel` defaults to `whatsapp`, and `sms` or `all` return the local SMS text templates as well. Rows of every provider are returned; each carries `is_selectable` / `disabled_reason`, and only templates of the currently configured provider are selectable.\n\n**Pagination is opt-in.** The response is paginated (20 per page, max 100) only when any of `channel`, `search`, `status`, `per_page` or `page` is sent; otherwise `templates` is a plain array of every row. `approved_only` forces `channel=whatsapp` and restricts rows to APPROVED templates of the current provider.\n\nA channel that is not active (or a call with no active channel at all) returns 422 `The selected messaging channel is not enabled.` Note that the default `channel=whatsapp` therefore fails on an SMS-only install.\n\n**PRO** (FluentCampaign Pro). The route exists only while the Messaging module (the `messaging_module` experimental setting) is switched on, and the policy answers 403 unless at least one channel (SMS or WhatsApp) is active.\n\n<!-- fc:access -->\n\n**Required capability:** `fcrm_read_emails` or `fcrm_manage_email_templates` \u2014 which one applies depends on the action being performed.\n\n_Enforced by `MessagePolicy::index()`._\n\n**Requires:** FluentCampaign Pro **with the Messaging module enabled**. While no messaging channel (SMS or WhatsApp) is switched on the route is not registered at all and returns a 404.\n\n<!-- /fc:access -->",
        "tags": [
          "WhatsApp"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "description": "Template channel. Unknown values fall back to whatsapp.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "whatsapp",
              "enum": [
                "whatsapp",
                "sms",
                "all"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Review status filter; upper-cased before matching, for example APPROVED, PENDING, REJECTED, PAUSED, DISABLED.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "approved_only",
            "in": "query",
            "description": "When truthy, return only APPROVED WhatsApp templates of the current provider.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Substring match on name, category, status, provider or body text.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Rows per page (capped at 100). Sending it turns pagination on.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number. Sending it turns pagination on.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Templates and status counts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "templates": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MessageTemplate"
                          }
                        },
                        {
                          "type": "object",
                          "description": "Paginated result set, returned when any paging or filter parameter is sent.",
                          "properties": {
                            "total": {
                              "type": "integer",
                              "description": "Total number of matching rows."
                            },
                            "per_page": {
                              "type": "integer",
                              "description": "Rows per page."
                            },
                            "current_page": {
                              "type": "integer",
                              "description": "Current page number."
                            },
                            "last_page": {
                              "type": "integer",
                              "description": "Number of the final page."
                            },
                            "from": {
                              "type": "integer",
                              "description": "Index of the first row on this page."
                            },
                            "to": {
                              "type": "integer",
                              "description": "Index of the last row on this page."
                            },
                            "next_page_url": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "URL of the next page, or null."
                            },
                            "prev_page_url": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "URL of the previous page, or null."
                            },
                            "data": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/MessageTemplate"
                              }
                            }
                          }
                        }
                      ],
                      "description": "Array when no paging/filter parameter was sent, paginator object otherwise."
                    },
                    "supports_sync": {
                      "type": "boolean",
                      "description": "True when the configured provider driver supports templates (sync, submit, delete)."
                    },
                    "current_provider": {
                      "type": "string",
                      "description": "Configured WhatsApp provider slug."
                    },
                    "current_provider_label": {
                      "type": "string",
                      "description": "Display label of the provider."
                    },
                    "provider_labels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Provider slug to label map."
                    },
                    "last_synced_at": {
                      "type": "string",
                      "description": "Latest last_synced_at among WhatsApp rows in the result set; empty string if none or WhatsApp is not queried."
                    },
                    "has_inactive_provider_templates": {
                      "type": "boolean",
                      "description": "True when stored WhatsApp templates belong to a provider other than the current one."
                    },
                    "counts": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "Rows matching the filters."
                        },
                        "approved": {
                          "type": "integer",
                          "description": "APPROVED rows."
                        },
                        "pending": {
                          "type": "integer",
                          "description": "PENDING rows."
                        },
                        "rejected": {
                          "type": "integer",
                          "description": "REJECTED rows."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "templates": [
                    {
                      "id": 12,
                      "channel": "whatsapp",
                      "provider": "meta_cloud",
                      "name": "order_update",
                      "language": "en_US",
                      "category": "UTILITY",
                      "status": "APPROVED",
                      "header_text": "",
                      "body_text": "Hi {{1}}, your order {{2}} has shipped.",
                      "footer_text": "Reply STOP to opt out",
                      "buttons": [
                        {
                          "type": "QUICK_REPLY",
                          "text": "Track order"
                        }
                      ],
                      "variables": {
                        "1": "Jane",
                        "2": "#1001"
                      },
                      "provider_template_id": "1029384756102938",
                      "rejection_reason": "",
                      "last_synced_at": "2026-09-30 10:00:00",
                      "created_by": 1,
                      "created_at": "2026-09-30 10:00:00",
                      "updated_at": "2026-09-30 10:00:00",
                      "provider_label": "Meta Cloud API",
                      "current_provider": "meta_cloud",
                      "current_provider_label": "Meta Cloud API",
                      "is_current_provider": true,
                      "is_selectable": true,
                      "disabled_reason": ""
                    }
                  ],
                  "supports_sync": true,
                  "current_provider": "meta_cloud",
                  "current_provider_label": "Meta Cloud API",
                  "provider_labels": {
                    "meta_cloud": "Meta Cloud API",
                    "twilio_whatsapp": "Twilio WhatsApp"
                  },
                  "last_synced_at": "2026-09-30 10:00:00",
                  "has_inactive_provider_templates": false,
                  "counts": {
                    "total": 1,
                    "approved": 1,
                    "pending": 0,
                    "rejected": 0
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated \u2014 missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated but the user lacks the capability this route requires.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The selected messaging channel is not enabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            }
          }
        }
      },
      "MessageTemplate": {
        "type": "object",
        "description": "A row of fc_message_templates. WhatsApp rows mirror a Meta/Twilio template; SMS rows (only returned when channel=sms or all) are local text bodies.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Template row ID."
          },
          "channel": {
            "type": "string",
            "description": "Template channel.",
            "enum": [
              "whatsapp",
              "sms"
            ]
          },
          "provider": {
            "type": "string",
            "description": "Provider slug the template belongs to (meta_cloud or twilio_whatsapp). Empty for SMS."
          },
          "name": {
            "type": "string",
            "description": "Template name. WhatsApp names are lowercase letters, digits and underscores."
          },
          "language": {
            "type": "string",
            "description": "Language code, for example en_US. SMS rows always use en."
          },
          "category": {
            "type": "string",
            "description": "Meta category: MARKETING, UTILITY or AUTHENTICATION. Empty for SMS."
          },
          "status": {
            "type": "string",
            "description": "Review status.",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "PAUSED",
              "DISABLED"
            ]
          },
          "header_text": {
            "type": "string",
            "description": "Text header, when present."
          },
          "body_text": {
            "type": "string",
            "description": "Body text with {{1}}, {{2}} placeholders."
          },
          "footer_text": {
            "type": "string",
            "description": "Footer text, when present."
          },
          "buttons": {
            "type": "array",
            "description": "Buttons (QUICK_REPLY, URL, PHONE_NUMBER).",
            "items": {
              "type": "object"
            }
          },
          "variables": {
            "type": "object",
            "description": "Example values for the placeholders, as submitted for review."
          },
          "provider_template_id": {
            "type": "string",
            "description": "Provider-side template ID (Meta template id or Twilio Content SID)."
          },
          "rejection_reason": {
            "type": "string",
            "description": "Provider rejection reason, when rejected."
          },
          "last_synced_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the row was last confirmed against the provider."
          },
          "created_by": {
            "type": [
              "integer",
              "null"
            ],
            "description": "WordPress user ID that submitted the template."
          },
          "created_at": {
            "type": "string",
            "description": "Creation timestamp."
          },
          "updated_at": {
            "type": "string",
            "description": "Update timestamp."
          },
          "provider_label": {
            "type": "string",
            "description": "Display label of the template's provider."
          },
          "current_provider": {
            "type": "string",
            "description": "Provider currently configured for WhatsApp."
          },
          "current_provider_label": {
            "type": "string",
            "description": "Display label of the current provider."
          },
          "is_current_provider": {
            "type": "boolean",
            "description": "True when the template belongs to the configured provider."
          },
          "is_selectable": {
            "type": "boolean",
            "description": "Whether the template may be picked for a send. Templates of another provider are not selectable."
          },
          "disabled_reason": {
            "type": "string",
            "description": "Why the template is not selectable; empty when it is."
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
