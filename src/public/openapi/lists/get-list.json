{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCRM API",
    "description": "Complete REST API documentation for FluentCRM \u2014 a self-hosted email marketing and CRM plugin for WordPress.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-crm/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/lists/{id}": {
      "get": {
        "operationId": "getList",
        "summary": "GET Get List",
        "description": "Retrieve a single contact list by its ID.\n\nThe list object is returned **at the top level** \u2014 there is no `list` wrapper key. A missing id yields `null` rather than a 404.\n\n<!-- fc:access -->\n\n**Required capability:** `fcrm_manage_contact_cats`\n\n_Enforced by `ListPolicy::verifyRequest()`, the policy default for this route group._\n\n<!-- /fc:access -->",
        "tags": [
          "Lists"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the list to retrieve.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List found successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "List id."
                    },
                    "title": {
                      "type": "string",
                      "description": "List name."
                    },
                    "slug": {
                      "type": "string",
                      "description": "URL-friendly unique identifier."
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Optional description. Null when never set."
                    },
                    "is_public": {
                      "type": "string",
                      "description": "`\"1\"` when the list may be shown on public preference pages, `\"0\"` otherwise. Returned as a string, not a boolean.",
                      "enum": [
                        "0",
                        "1"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Creation timestamp.",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "Last update timestamp.",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "id": 1,
                  "title": "Community Members",
                  "slug": "community-members",
                  "description": null,
                  "is_public": "0",
                  "created_at": "2024-03-27 00:52:39",
                  "updated_at": "2024-03-27 00:52:39"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            }
          }
        }
      },
      "ContactList": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the list."
          },
          "title": {
            "type": "string",
            "description": "Display name of the list."
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly unique identifier."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional description of the list."
          },
          "is_public": {
            "type": "integer",
            "description": "Whether the list is publicly visible. `0` for private, `1` for public.",
            "enum": [
              0,
              1
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the list was created (WordPress timezone)."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the list was last updated (WordPress timezone)."
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
